# Next.js build directories and files
.next/           # The build output directory
# out/             # Optional: if you use a custom output directory (e.g., for static exports)
.swc/            # Next.js uses the swc compiler cache

# Dependencies
node_modules/    # Project dependencies
/build           # Optional: if you use 'react-scripts build' in a separate React app

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files
.env             # Environment variables
.env.local       # Local environment variables
.env.development.local
.env.test.local
.env.production.local
.env.staging.local

# Local history files
.history

# IDE-specific files (optional, adjust as needed)
.idea/           # JetBrains IDEs (IntelliJ, WebStorm, etc.)
.vscode/         # VS Code settings (uncomment if you want to ignore workspace settings)
*.iml            # JetBrains project files

# OS-specific files
.DS_Store        # macOS files
Thumbs.db        # Windows files

